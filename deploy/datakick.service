# systemd service: starts Data-Kick at boot and restarts it if it stops
# Install: sudo cp deploy/datakick.service /etc/systemd/system/ && sudo systemctl enable --now datakick
# Logs:    journalctl -u datakick -f

[Unit]
Description=Data-Kick (predictions website)
# PostgreSQL runs in Docker: wait for it
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Data-Kick/src
ExecStart=/home/ubuntu/Data-Kick/.venv/bin/python server.py
Environment=PYTHONUNBUFFERED=1
Environment=PORT=8000
# Only Caddy (same machine) talks to the server
Environment=HOST=127.0.0.1
# If the database is not ready yet at boot, retry until it is
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
